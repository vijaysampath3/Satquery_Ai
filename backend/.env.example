# SatQuery AI Backend Environment Configuration
# Copy this file to .env and set your API keys as needed.

# OpenRouter API Key (Required for LLM natural language summary overviews)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# GPU VRAM Limit (in GB)
MAX_VRAM_GB=8.0
